# Application Settings
APP_NAME=Mattilda School Management API
APP_VERSION=1.0.0
API_PREFIX=/api
DEBUG=False

# Database Configuration
# Individual components (used to construct DATABASE_URL)
POSTGRES_USER=mattilda
POSTGRES_PASSWORD=mattilda123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mattilda_db

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=3600

# Redis Configuration (for Event-Driven Accounting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Authentication & Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
# Comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Server Configuration (for uvicorn)
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=False
